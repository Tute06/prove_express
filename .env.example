# Copiar a .env (no se commitea) y completar.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Puerto público de nginx (80 en el Cloud Server, 8097 en rocky)
HTTP_PORT=80
AI_LIMIT_PER_10MIN=40
ALLOW_RESET=0
# Firma de la cookie de sesión (si falta se genera una al arrancar y las sesiones se pierden al reiniciar)
SESSION_SECRET=
